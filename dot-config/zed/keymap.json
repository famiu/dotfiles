// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Dock",
        "bindings": {
            // Use Vim window keybindings to navigate docks.
            "ctrl-w h": "workspace::ActivatePaneLeft",
            "ctrl-w l": "workspace::ActivatePaneRight",
            "ctrl-w k": "workspace::ActivatePaneUp",
            "ctrl-w j": "workspace::ActivatePaneDown"
        }
    },
    {
        "context": "Workspace",
        "bindings": {}
    },
    {
        "context": "Editor",
        "bindings": {}
    },
    {
        "context": "Editor && !menu",
        "bindings": {
            "ctrl-b": "workspace::ToggleLeftDock",
            "ctrl-f": "buffer_search::Deploy"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            "ctrl-j": ["terminal::SendKeystroke", "ctrl-j"]
        }
    },
    {
        "context": "vim_mode == normal && !menu",
        "bindings": {
            // CTRL-L to clear search.
            "ctrl-l": "buffer_search::Dismiss",
            // Use H and L to go to beginning and end of line.
            "shift-h": ["workspace::SendKeystrokes", "^"],
            "shift-l": ["workspace::SendKeystrokes", "$"],
            // Use neovim's yank behavior: yank to end of line.
            "shift-y": ["workspace::SendKeystrokes", "y $"],
            // Fuzzy search files
            "space space": "file_finder::Toggle",
            // Fuzzy search entire workspace
            "space /": "text_finder::Toggle"
        }
    },
    {
        "context": "vim_mode == visual",
        "bindings": {
            // Use S for surround in Visual mode.
            "shift-s": ["vim::PushAddSurrounds", {}],
            // Use X for exchange.
            "shift-x": "vim::Exchange"
        }
    },
    {
        "context": "vim_mode == normal || vim_mode == visual",
        "bindings": {
            "enter": "vim::HelixJumpToWord"
        }
    },
    {
        "context": "VimControl && !menu",
        "bindings": {}
    },
    {
        "context": "VimControl && !menu && vim_mode != operator",
        "bindings": {
            // Use subword motion.
            "w": "vim::NextSubwordStart",
            "b": "vim::PreviousSubwordStart",
            "e": "vim::NextSubwordEnd",
            "g e": "vim::PreviousSubwordEnd"
        }
    }
]
