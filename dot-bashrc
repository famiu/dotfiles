# vim: ft=bash

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:" ]]; then
    PATH="$HOME/.local/bin:$PATH"
fi
export PATH

# Load Rust environment
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Uncomment the following line to disable systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

# Load ble.sh in interactive shells, use --noattach to defer attaching until later to set up other settings first.
if [[ $- == *i* ]]; then
    blesh_src="$HOME/.config/bash/plugins/blesh"
    blesh_out=$blesh_src/out/ble.sh

    # Only rebuild if the output is missing or older than the source dir.
    if [[ -d $blesh_src ]] && { [[ ! -f $blesh_out ]] || [[ $blesh_src -nt $blesh_out ]]; }; then
        if make_cmd=$(command -v gmake || command -v make); then
            ( cd "$blesh_src" && "$make_cmd" ) >/dev/null 2>&1
        fi
    fi

    [[ -f $blesh_out ]] && source "$blesh_out" --noattach
fi

# If not running interactively, don't do anything else.
[[ $- != *i* ]] && return

# History settings
HISTCONTROL=ignoreboth:erasedups  # ignore space-prefixed lines, drop duplicates
HISTSIZE=1000
HISTFILESIZE=10000
HISTTIMEFORMAT='%F %T '           # timestamp each entry in `history`
HISTIGNORE='incognito*'           # skip incognito commands from history
shopt -s histappend               # append to history file, don't overwrite it

# Shell behavior options
shopt -s autocd        # `foo` instead of `cd foo`
shopt -s cdspell       # auto-correct minor cd typos
shopt -s globstar      # enable ** recursive glob

# Default editor
export EDITOR=nvim
export VISUAL=nvim

# Disable annoying bell
bind 'set bell-style none'

# Ignore EOF (Ctrl-D) to exit shell
set -o ignoreeof

# Fallback readline bindings used when ble.sh is not loaded.
if ! ((_ble_bash)); then
    bind 'set show-all-if-ambiguous on'
    bind 'set page-completions off'
    bind "set menu-complete-display-prefix on"
    bind 'TAB:menu-complete'
    bind '"\e[Z": menu-complete-backward'
    bind '"\e[A":history-search-backward'
    bind '"\e[B":history-search-forward'
    bind '"\e[1;5C":forward-word'
    bind '"\e[1;5D":backward-word'
fi

# Aliases
if command -v bat &> /dev/null; then
    alias cat='bat --style=plain'
fi

alias ls='ls --color=auto'
alias ll='ls -l --color=auto'
alias la='ls -la --color=auto'

if command -v eza &> /dev/null; then
    alias x='eza --icons=auto'
    alias xa='eza -a --icons=auto'
    alias xl='eza -l --icons=auto'
    alias xla='eza -la --icons=auto'
    alias xt='eza -T --icons=auto'
    alias xta='eza -Ta --icons=auto'
fi

alias lg='lazygit'
alias nv='nvim'

# Function to create directory and CD to it
function mkcd {
    mkdir -p "$1" && cd "$1"
}

# Per-command: `incognito {cmd}` runs {cmd} unrecorded. No-args: toggles incognito session mode.
incognito() {
    if [[ $# -gt 0 ]]; then
        "$@"
    elif [[ -z $INCOGNITO ]]; then
        set +o history
        export INCOGNITO=1
        echo "Incognito mode ON"
    else
        set -o history
        unset INCOGNITO
        echo "Incognito mode OFF"
    fi
}

# Cache generated init scripts for tools that `eval "$(...)"` on every shell
# start, regenerating only when missing or the binary is newer than the cache.
_cache_init() {
    local bin=$1 cache=$2 gen_cmd=$3
    if command -v "$bin" &> /dev/null; then
        if [[ ! -f $cache || $(command -v "$bin") -nt $cache ]]; then
            mkdir -p "$(dirname "$cache")"
            eval "$gen_cmd" > "$cache"
        fi
        source "$cache"
    fi
}

_cache_init starship "$HOME/.cache/shell-init/starship.bash" 'starship init bash'
_cache_init zoxide   "$HOME/.cache/shell-init/zoxide.bash"   'zoxide init bash'
_cache_init direnv   "$HOME/.cache/shell-init/direnv.bash"   'direnv hook bash'
unset -f _cache_init

# Carapace completion (cached the same way, but needs CARAPACE_BRIDGES set first)
if command -v carapace &> /dev/null; then
    export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
    carapace_cache="$HOME/.cache/shell-init/carapace.bash"
    if [[ ! -f $carapace_cache || $(command -v carapace) -nt $carapace_cache ]]; then
        mkdir -p "$(dirname "$carapace_cache")"
        carapace _carapace > "$carapace_cache"
    fi
    source "$carapace_cache"
    unset carapace_cache
fi

# Attach ble.sh
((_ble_bash)) && ble-attach
